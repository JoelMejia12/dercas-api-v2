# El administrador del VPS suministrará estos valores fuera del repositorio.
# Deje DATABASE_URL vacío y PG* sin definir hasta disponer de la conexión.
DATABASE_URL=
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=
# SSL deshabilitado por defecto. Para conexiones remotas, configurar verify-full.
PGSSL=disable

PORT=3000
LOG_LEVEL=info
NODE_ENV=development
# Obligatorio para iniciar la API: configure un valor aleatorio de al menos 32 bytes fuera del repositorio.
# El valor vacío es solo un marcador y hace que el proceso falle al arrancar.
AUTH_TOKEN_SECRET=
